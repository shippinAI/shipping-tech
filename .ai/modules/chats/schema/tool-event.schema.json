{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tool-event.schema.json",
  "title": "tool_event",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_key", "session_key", "event_id", "tool_name", "status", "input", "created_at"],
  "properties": {
    "project_key": {"type": "string", "minLength": 1},
    "session_key": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "minLength": 8},
    "tool_name": {"type": ["string", "null"]},
    "status": {"type": "string", "enum": ["observed", "succeeded", "failed", "blocked"]},
    "input": {"type": "object"},
    "created_at": {"type": "string", "minLength": 20}
  }
}
