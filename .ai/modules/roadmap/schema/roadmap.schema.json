{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "roadmap.schema.json",
  "title": "roadmap",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product", "objectives", "phases"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0"]},
    "product": {"type": "string", "minLength": 1},
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "source"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1}
        }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "status", "exit_proof"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["not_started", "in_progress", "blocked", "done"]},
          "exit_proof": {"type": "string", "minLength": 1},
          "depends_on": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
