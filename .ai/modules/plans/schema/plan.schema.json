{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "plan.schema.json",
  "title": "implementation plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "costar", "sources", "concerns", "context", "current_state", "target_design", "changes", "boundaries", "verification", "status"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0"]},
    "id": {"type": "string", "minLength": 8},
    "title": {"type": "string", "minLength": 1},
    "costar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "objective", "style", "tone", "audience", "response"],
      "properties": {
        "context": {"type": "string", "minLength": 1},
        "objective": {"type": "string", "minLength": 1},
        "style": {"type": "string", "minLength": 1},
        "tone": {"type": "string", "minLength": 1},
        "audience": {"type": "string", "minLength": 1},
        "response": {"type": "string", "minLength": 1}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref"],
        "properties": {
          "kind": {"type": "string", "enum": ["code", "web"]},
          "ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "concerns": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "context": {"type": "string", "minLength": 1},
    "current_state": {"type": "string", "minLength": 1},
    "target_design": {"type": "string", "minLength": 1},
    "changes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "boundaries": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "verification": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "command", "proves", "expected"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "command": {"type": "string", "minLength": 1},
          "proves": {"type": "string", "minLength": 1},
          "expected": {"type": "string", "minLength": 1},
          "result": {"type": "string"}
        }
      }
    },
    "status": {"type": "string", "enum": ["draft", "approved", "implemented"]}
  }
}
