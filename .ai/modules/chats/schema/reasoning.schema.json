{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "reasoning.schema.json",
  "title": "reasoning_observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_key", "session_key", "event_id", "kind", "content", "created_at"],
  "properties": {
    "project_key": {"type": "string", "minLength": 1},
    "session_key": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "minLength": 8},
    "kind": {"type": "string", "enum": ["thought", "summary", "compaction", "governance", "rro"]},
    "content": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 20}
  }
}
